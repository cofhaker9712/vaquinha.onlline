# Banco PostgreSQL. O projeto aceita DATABASE_URL ou POSTGRES_URL (Vercel/Neon).
DATABASE_URL=

# Credenciais do dashboard ObyPay. Nunca use NEXT_PUBLIC_ ou exponha no navegador.
OBYPAY_API_KEY=
OBYPAY_WEBHOOK_SECRET=

# URL HTTPS pública e estável deste site, sem / no final.
# Exemplo: https://seu-projeto.vercel.app
APP_URL=
